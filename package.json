{
  "name": "retro-mix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite",
    "backend:audio": "bun src/backend/audioServer.ts",
    "build": "vue-tsc -b && vite build",
    "test": "bun test",
    "preview": "vite preview",
    "android:sync": "bun run build && bunx cap sync android",
    "android:open": "bunx cap open android",
    "android:apk": "bun run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.0.0",
    "@vitejs/plugin-vue": "latest",
    "lucide-vue-next": "^0.468.0",
    "vite": "latest",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "sass": "^1.83.0",
    "typescript": "~5.7.2",
    "vue-tsc": "^2.2.0"
  }
}
